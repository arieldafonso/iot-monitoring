# IoT Monitoring - Configuration File
# This file should be created locally and added to .gitignore
# See .env.example for the list of available variables

# MQTT Configuration
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PATTERN=harryspace/+/+

# InfluxDB Configuration
INFLUX_HOST=influxdb
INFLUX_PORT=8086
INFLUX_DB=harryspace
INFLUX_USER=user
INFLUX_PASSWORD=password

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Bridge Configuration
LOCATION=01

# Ping Monitor Configuration
SWITCH_IP=192.168.1.1
PING_INTERVAL=5

# Logging Configuration
LOG_LEVEL=INFO

# Alert Service - External RabbitMQ
RABBITMQ_URL=amqp://user:password@your-rabbitmq-host:5672
RABBITMQ_QUEUE=alert-events
